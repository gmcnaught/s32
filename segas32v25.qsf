# --------------------------------------------------------------------------
#
# MiSTer project
#
# WARNING WARNING WARNING:
# Do not add files to project in Quartus IDE! It will mess this file!
# Add the files manually to files.qip file.
#
# --------------------------------------------------------------------------

# 2026-08-06: split back out of the single merged "s32" profile into two
# dedicated profiles (this repository's shipping shape as of this date):
#   segas32v25.qsf (this file): the real NEC V25 games only -- Golden Axe:
#     The Revenge of Death Adder (ga2) and Arabian Fight (arabfgt).
#   segas32.qsf: every other in-scope System 32 game, real V25 hardware not
#     compiled in at all (HLE only). Currently scoped to Sonic only; other
#     games return one at a time (see tools/gen_mra.py:GAMES/IGNORED_PARENTS,
#     PROFILE_CONTRACT.md).
# This file is otherwise unchanged from the retired single-profile "s32.qsf"
# for this game scope -- same macros, same fitter settings, same seed. Its
# resource/timing state as of the split: 32,791/41,910 ALMs (78%),
# 517/553 M10K (93%), worst setup slack -0.210/-0.080 ns (not yet fully
# closed -- see the SEED comment below for the full investigation history).

set_global_assignment -name TOP_LEVEL_ENTITY sys_top

set_global_assignment -name LAST_QUARTUS_VERSION "17.0.2 Lite Edition"

set_global_assignment -name GENERATE_RBF_FILE ON
set_global_assignment -name PROJECT_OUTPUT_DIRECTORY output_files
set_global_assignment -name SAVE_DISK_SPACE OFF
# Preserve compilation databases so Smart Recompile can reuse unchanged work.
set_global_assignment -name SMART_RECOMPILE ON
set_global_assignment -name MIN_CORE_JUNCTION_TEMP "-40"
set_global_assignment -name MAX_CORE_JUNCTION_TEMP 100
set_global_assignment -name POWER_PRESET_COOLING_SOLUTION "23 MM HEAT SINK WITH 200 LFPM AIRFLOW"
set_global_assignment -name POWER_BOARD_THERMAL_MODEL "NONE (CONSERVATIVE)"
# Qualify release timing at all process/voltage/temperature corners, including
# the fast-corner hold checks the single-corner flow skipped (audit R20 PF-5).
set_global_assignment -name TIMEQUEST_MULTICORNER_ANALYSIS ON
set_global_assignment -name OPTIMIZE_POWER_DURING_FITTING OFF
set_global_assignment -name FINAL_PLACEMENT_OPTIMIZATION ALWAYS
set_global_assignment -name FITTER_EFFORT "FAST FIT"
# The current real-V25 image fits at 77% ALMs with only 57% peak routing
# congestion, but the clean 2026-08-09 build missed the 148.54 MHz HDMI
# domain by 0.378 ns (best of seeds 2/3) and clk_sys by 0.202 ns. Spend the
# available logic/routing headroom on timing-driven synthesis and placement;
# RAM-block use (93%) is the tight resource and is unaffected by this choice.
set_global_assignment -name OPTIMIZATION_MODE "HIGH PERFORMANCE EFFORT"
set_global_assignment -name FITTER_AGGRESSIVE_ROUTABILITY_OPTIMIZATION ALWAYS
set_global_assignment -name ALLOW_POWER_UP_DONT_CARE OFF
set_global_assignment -name QII_AUTO_PACKED_REGISTERS NORMAL
set_global_assignment -name ROUTER_LCELL_INSERTION_AND_LOGIC_DUPLICATION ON
set_global_assignment -name PHYSICAL_SYNTHESIS_COMBO_LOGIC OFF
set_global_assignment -name PHYSICAL_SYNTHESIS_REGISTER_DUPLICATION OFF
# 2026-08-06: tried register retiming ON, twice -- once on the trackball/
# prot_hle-included netlist (-0.431/-0.415 ns) and once on the reverted
# netlist (-0.210/-0.080 ns). Both times bit-identical to retiming OFF:
# confirmed genuine no-op for this design, not netlist-dependent. Reverted.
set_global_assignment -name PHYSICAL_SYNTHESIS_REGISTER_RETIMING OFF
set_global_assignment -name OPTIMIZATION_TECHNIQUE SPEED
set_global_assignment -name MUX_RESTRUCTURE ON
set_global_assignment -name REMOVE_REDUNDANT_LOGIC_CELLS ON
set_global_assignment -name AUTO_DELAY_CHAINS_FOR_HIGH_FANOUT_INPUT_PINS ON
set_global_assignment -name PHYSICAL_SYNTHESIS_COMBO_LOGIC_FOR_AREA OFF
set_global_assignment -name ADV_NETLIST_OPT_SYNTH_WYSIWYG_REMAP ON
set_global_assignment -name SYNTH_GATED_CLOCK_CONVERSION ON
set_global_assignment -name PRE_MAPPING_RESYNTHESIS ON
set_global_assignment -name ROUTER_CLOCKING_TOPOLOGY_ANALYSIS ON
set_global_assignment -name ROUTER_TIMING_OPTIMIZATION_LEVEL NORMAL
set_global_assignment -name ECO_OPTIMIZE_TIMING ON
set_global_assignment -name PERIPHERY_TO_CORE_PLACEMENT_AND_ROUTING_OPTIMIZATION ON
set_global_assignment -name PHYSICAL_SYNTHESIS_ASYNCHRONOUS_SIGNAL_PIPELINING ON
set_global_assignment -name ALM_REGISTER_PACKING_EFFORT MEDIUM
# 2026-08-05: seed 2 was the best archived-legal-fit seed for the *pre-audit*
# resource profile. This session's RAM-inference fixes in
# s32_v25_rom_cache and comm_ram freed enough ALUTs to change the design's
# whole placement problem, exposing marginal sub-0.2ns setup paths
# (s32_tilemap lay->vram_addr) that were never the worst path before, once
# the OSD pixcnt/multiscan multicycle exceptions below closed the larger
# vendor-OSD violations. Re-checked seed 3 per the timing-closure playbook
# (try up to 3 additional seeds once logic/constraints are correct, before
# touching RTL for a placement-sensitive violation this small): seed 3 was
# worse (-0.831 ns worst setup vs seed 2's -0.183 ns). Kept seed 2.
#
# 2026-08-06: the Sonic-enablement resource work (trackball s32_upd4701,
# s32_prot_hle always instantiated) briefly lived in this same profile and
# measurably worsened this same path family to -0.431/-0.415 ns for zero
# benefit to ga2/arabfgt. Reverted (that work now belongs in segas32.qsf,
# the profile that actually needs it). Kept the s32_ga_rom_cache arbiter
# extension and the s32_gun_aim gating (both inert/beneficial regardless of
# profile). Re-tried seed 4 (-0.605/-0.436 ns) and seed 1 (-0.746/-0.674 ns)
# on the reverted netlist and register retiming (no-op, see above): seed 2
# remains the best known placement at -0.210/-0.080 ns, not yet 0. A targeted
# RTL fix (video_ram/sprite_ram's read-only port B forced into
# BIDIR_DUAL_PORT mode) was attempted and reverted after a synthesis error
# (see rtl/video/s32_big_dpram.sv's header) -- needs correct Intel altsyncram
# DUAL_PORT documentation before retrying, not another blind guess. See
# verif/timing/get_worst_paths.tcl for the exact failing nodes.
set_global_assignment -name SEED 2
# Quartus 17.0.2 has crashed in l_run_heap_expansion_algorithm while routing
# this 99%-full real-V25 image with parallel fitter workers.  A single fitter
# worker is slower but avoids that nondeterministic router failure.
set_global_assignment -name NUM_PARALLEL_PROCESSORS 8

# This repository is single-screen Sega System 32 only; Multi 32 is not a
# supported target here.  The macro compiles out the second palette / mixer and
# sizes work RAM to the board-correct 64 KiB so this RBF fits the Cyclone V
# memory budget.  The Multi 32 arms remain in the RTL because is_multi32 folds
# to a constant and reclaims no logic -- deleting them buys nothing.  Every
# revision in this repository must set this macro; Multi32ExclusionTests in
# verif/test_gen_mra.py keeps the MRA side in step.
set_global_assignment -name VERILOG_MACRO "S32_SYSTEM32_ONLY=1"
set_global_assignment -name VERILOG_MACRO "S32_PROFILE_STANDARD=1"
set_global_assignment -name VERILOG_MACRO "S32_PCB_TIMING=1"
# This RBF is scoped to exactly ga2/arabfgt. GAME_ONLY strips analog/
# trackball/generic-protection/dual-PCB entirely (neither game uses any of
# it -- both are PROT_NONE) and selects the dedicated synchronous V60 ROM
# cache (S32_AREA_ROM_CACHE) instead of the generic one. That cache's
# SDRAM-p0 arbiter now supports a real protection-ROM-read grant (2026-08-06,
# rtl/s32_core.sv's s32_ga_rom_cache instantiation) but neither game here
# drives one, so it is behavior-inert in this profile; it exists so
# rtl/s32_core.sv stays identical between profiles.
set_global_assignment -name VERILOG_MACRO "S32_GAME_ONLY=1"
# Neither ga2 nor Arabian Fight executes the optional V60 floating-point
# group. Re-review before adding any future game to this profile.
set_global_assignment -name VERILOG_MACRO "S32_V60_NO_FP=1"
set_global_assignment -name VERILOG_MACRO "S32_JT12_MLAB_SHIFTS=1"

# --- Real V25 (Golden Axe: The Revenge of Death Adder / Arabian Fight) -------
# The real NEC V25 (rtl/cpu/v25/v25.qip: the s80x86 core, s32_v25_cpu and
# s32_v25_rom_cache) is compiled in only for this profile; segas32.qsf uses
# the static HLE responder s32_v25 (rtl/prot/s32_prot.sv) instead, since none
# of its games have V25 protection hardware. cfg_has_v25 is still read from
# the board descriptor like every other per-game config bit
# (tools/gen_mra.py:GAMES), so this file only needs to compile the real core;
# it does not need to force it on.
#
# S80X86_PSEUDO_286_INT is a required compile-time choice for the upstream
# s80x86 Flags module whenever its source is part of the build at all.
set_global_assignment -name VERILOG_MACRO "S80X86_PSEUDO_286_INT=0"
set_global_assignment -name QIP_FILE rtl/cpu/v25/v25.qip
set_global_assignment -name VERILOG_MACRO "S32_REAL_V25=1"
set_global_assignment -name VERILOG_MACRO "S32_V25_MLAB_FIFO=1"
# The 64x16 EEPROM otherwise consumes an entire M10K because its original
# true-dual-port primitive is not MLAB-compatible.  The profile-specific RTL
# uses two coherent simple-dual-port MLAB replicas to retain both read views.
set_global_assignment -name VERILOG_MACRO "S32_V25_MLAB_EEPROM=1"

#set_global_assignment -name VERILOG_MACRO "MISTER_FB=1"

#enable it only if 8bit indexed mode is used in core
#set_global_assignment -name VERILOG_MACRO "MISTER_FB_PALETTE=1"


# disable bilinear filtering when downscaling
set_global_assignment -name VERILOG_MACRO "MISTER_DOWNSCALE_NN=1"

# Holosseum's native image is at most 416x224. Disable only scaler output modes
# smaller than the source image to remove the remaining input-line RAM and
# downscale routing; normal HDMI upscale and direct video remain available.
set_global_assignment -name VERILOG_MACRO "MISTER_DISABLE_DOWNSCALE=1"

# disable adaptive scanline filtering
set_global_assignment -name VERILOG_MACRO "MISTER_DISABLE_ADAPTIVE=1"

# The two real-V25 games do not require the optional HDMI CRT shadow-mask
# post-process.  Compile out its 256x11 dual-port LUT and multiplier/control
# stage from the shared HDMI pipeline; direct video, OSD, sync, and scaler
# output remain available.
set_global_assignment -name VERILOG_MACRO "MISTER_DISABLE_SHADOWMASK=1"

#use only 1MB per frame for scaler to free ~21MB DDR3 RAM
#set_global_assignment -name VERILOG_MACRO "MISTER_SMALL_VBUF=1"

# Disable YC / Composite output to save some resources
set_global_assignment -name VERILOG_MACRO "MISTER_DISABLE_YC=1"

# Disable ALSA audio output to save some resources
set_global_assignment -name VERILOG_MACRO "MISTER_DISABLE_ALSA=1"

source sys/sys.tcl
source sys/sys_analog.tcl
source files.qip
