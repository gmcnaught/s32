# Sega System 32 — project file list (System 32 only; no Multi 32 target).
# s32_multipcm.sv stays listed because S32_SYSTEM32_ONLY folds is_multi32 to a
# constant and the instance optimises away; removing it reclaims no logic.
set_global_assignment -name QIP_FILE sys/sys.qip
set_global_assignment -name SDC_FILE s32.sdc

set_global_assignment -name SYSTEMVERILOG_FILE Arcade-SegaSystem32.sv
set_global_assignment -name SYSTEMVERILOG_FILE rtl/s32_pkg.sv
set_global_assignment -name SYSTEMVERILOG_FILE rtl/s32_core.sv

set_global_assignment -name SYSTEMVERILOG_FILE rtl/cpu/v60/s32_v60.sv
set_global_assignment -name SYSTEMVERILOG_FILE rtl/cpu/v60/s32_v60_bus.sv
# The real NEC V25 (rtl/cpu/v25/v25.qip: s80x86 + s32_v25_cpu +
# s32_v25_rom_cache) belongs to the s32v25 revision only -- it is hardware for
# Golden Axe: The Revenge of Death Adder and Arabian Fight alone.  Every other
# System 32 title uses the HLE responder s32_v25 in rtl/prot/s32_prot.sv, which
# is listed below.  s32v25.qsf sources this file and then adds v25.qip itself,
# so the standard revision never compiles the s80x86 core at all.

set_global_assignment -name SYSTEMVERILOG_FILE rtl/video/s32_big_dpram.sv
set_global_assignment -name SYSTEMVERILOG_FILE rtl/video/s32_vram.sv
set_global_assignment -name SYSTEMVERILOG_FILE rtl/video/s32_tilemap.sv
set_global_assignment -name SYSTEMVERILOG_FILE rtl/video/s32_sprite.sv
set_global_assignment -name SYSTEMVERILOG_FILE rtl/video/s32_linebuf.sv
set_global_assignment -name SYSTEMVERILOG_FILE rtl/video/s32_mixer.sv
set_global_assignment -name SYSTEMVERILOG_FILE rtl/video/s32_palette.sv
set_global_assignment -name SYSTEMVERILOG_FILE rtl/video/s32_video.sv

set_global_assignment -name SYSTEMVERILOG_FILE rtl/audio/s32_audio_mix.sv
set_global_assignment -name SYSTEMVERILOG_FILE rtl/audio/s32_soundsys.sv
set_global_assignment -name SYSTEMVERILOG_FILE rtl/audio/s32_rf5c68.sv
set_global_assignment -name SYSTEMVERILOG_FILE rtl/audio/s32_multipcm.sv
set_global_assignment -name QIP_FILE rtl/audio/T80/T80.qip
set_global_assignment -name QIP_FILE rtl/audio/jt12/jt12.qip

set_global_assignment -name SYSTEMVERILOG_FILE rtl/io/s32_io.sv
set_global_assignment -name SYSTEMVERILOG_FILE rtl/prot/s32_prot.sv

set_global_assignment -name SYSTEMVERILOG_FILE rtl/mem/sdram.sv
set_global_assignment -name SYSTEMVERILOG_FILE rtl/mem/s32_rom_loader.sv
set_global_assignment -name SYSTEMVERILOG_FILE rtl/mem/s32_fb_if.sv

set_global_assignment -name QIP_FILE rtl/pll/pll.qip
